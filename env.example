# Скопировать в .env. Вложенность через двойное подчёркивание.

APP__ENVIRONMENT=local
APP__DEBUG=true
# Валидатор в AppSettings не даст включить это в dev и prod.
APP__DISABLE_AUTH=true

POSTGRES__DB=soniks_orbit
POSTGRES__USER=admin
POSTGRES__PASSWORD=soniks
POSTGRES__HOST=orbit-postgres
POSTGRES__PORT=5432

RABBIT__USER=guest
RABBIT__PASSWORD=guest
RABBIT__HOST=orbit-rabbitmq
RABBIT__PORT=5672

# Боевой Django, а не реплика dev2: опубликованное на реплике TLE
# не дошло бы до планирования наблюдений реальной сети (decisions/009).
NETWORK_API__BASE_URL=https://sonik.space

# Keycloak общий с монолитом и с v2 (decisions/008).
# При APP__DISABLE_AUTH=true не используется.
AUTH__KEYCLOAK__BASE_URL=
AUTH__KEYCLOAK__REALM=
AUTH__KEYCLOAK__CLIENT_ID=
AUTH__JWT__ISSUER=
